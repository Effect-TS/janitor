{
  "name": "@janitor/runner",
  "version": "0.0.0",
  "private": true,
  "description": "Janitor agent session runner: one sandbox-owning Durable Object per session hosting the pinned OpenCode Workerd SDK.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "vp run typecheck && vp run build && vp run test",
    "smoke:local": "node dev/smoke.ts"
  },
  "dependencies": {
    "@cloudflare/sandbox": "0.12.9",
    "@opencode/ai": "2.0.2",
    "@opencode/core": "2.0.2",
    "@opencode/schema": "2.0.2",
    "@opencode/sdk": "2.0.2",
    "@opencode/server": "2.0.2",
    "alchemy": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@effect/platform-node": "catalog:",
    "@types/node": "24.13.3",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0"
}
