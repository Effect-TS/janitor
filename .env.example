# Copy to .env.production. Never commit populated files.
# Must match the stage in the vp task. Hosts are fixed by Deployment.ts.
JANITOR_STAGE=production
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME
NEON_API_KEY=CHANGE_ME

# Effectful-Tech GitHub identity provider in effectful.cloudflareaccess.com
CLOUDFLARE_ACCESS_GITHUB_IDP_ID=CHANGE_ME

# Production GitHub App.
JANITOR_GITHUB_APP_ID=CHANGE_ME
# Quoted PEM with escaped newlines, or supply via the process environment.
JANITOR_GITHUB_APP_PRIVATE_KEY="CHANGE_ME"
JANITOR_GITHUB_WEBHOOK_SECRET=CHANGE_ME
# A base64-encoded, randomly generated 32-byte AES key.
JANITOR_GITHUB_WEBHOOK_PAYLOAD_KEY=CHANGE_ME
JANITOR_GITHUB_WEBHOOK_PAYLOAD_KEY_ID=primary-v1

# Access subject (the JWT `sub` claim) of the first admin. Later teammates
# are admitted as members on first sign-in; admins promote them in Account.
JANITOR_INITIAL_ADMIN_SUBJECT=CHANGE_ME

# Optional. Sign in with Slack (OpenID Connect) for connecting Slack accounts.
# All three are required together; leave them unset to disable Slack linking.
# Register https://<domain>/account/slack/return as a redirect URL on the app.
# JANITOR_SLACK_CLIENT_ID=
# JANITOR_SLACK_CLIENT_SECRET=
# Comma-separated Slack team IDs (T...) whose members may connect.
# JANITOR_SLACK_WORKSPACE_IDS=

# Optional. The production GitHub App's OAuth client for connecting GitHub
# accounts. Both are required together; leave them unset to disable GitHub
# linking. Register https://<domain>/account/github/return as a callback URL.
# JANITOR_GITHUB_OAUTH_CLIENT_ID=
# JANITOR_GITHUB_OAUTH_CLIENT_SECRET=

# Seven days; select a Neon plan that supports this window.
NEON_HISTORY_RETENTION_SECONDS=604800
# Optional. Repository AI consent remains disabled until explicitly enabled.
# OPENAI_API_KEY=
# OPENAI_API_URL=
# LABELING_AI_MODEL=
# Optional input byte budget including reserved framing (4,000–64,000).
# LABELING_AI_INPUT_BYTES=16000
# Optional cache lifetime for all AI rules, in whole seconds (1–2147483647).
# LABELING_AI_CACHE_TTL_SECONDS=86400

# Optional private Slack conversations. All five plus the runner connection
# must be set together. Bot grants are separate from Slack OIDC linking.
# JANITOR_SLACK_WORKSPACE_ID=
# JANITOR_SLACK_APP_ID=
# JANITOR_SLACK_BOT_USER_ID=
# JANITOR_SLACK_BOT_TOKEN=
# JANITOR_SLACK_SIGNING_SECRET=
# Production agent runner, deployed by the same Alchemy stack.
# Generate two distinct random service tokens; Alchemy supplies each to both Workers.
JANITOR_AGENT_RUNNER_TOKEN=CHANGE_ME
REPOSITORY_SERVICE_TOKEN=CHANGE_ME
# Team OpenRouter API key, bound only to the runner Worker.
JANITOR_AGENT_RUNNER_MODEL_API_KEY=CHANGE_ME
# R2 API token (Object Read & Write on the janitor-workspace-checkpoints bucket) for
# sandbox recovery points. Containers upload backups straight to R2 through presigned URLs.
JANITOR_SANDBOX_R2_ACCESS_KEY_ID=CHANGE_ME
JANITOR_SANDBOX_R2_SECRET_ACCESS_KEY=CHANGE_ME
# Optional JSON override. Defaults to apps/runner/model-configurations/openrouter-llama-3.1-8b.json.
# Preserve old records when changing the default for new sessions.
# JANITOR_AGENT_RUNNER_MODEL_CONFIGURATIONS=
# Production URL and release identity are derived by Alchemy, not configured here.
# For local development only, connect an independently running local runner:
# JANITOR_AGENT_RUNNER_URL=
