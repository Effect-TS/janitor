# Production settings. They live in Infisical (project `janitor`, environment
# `production`, path `/`), which alchemy.run.ts loads for the production stage.
# Infisical overrides the shell. Leave optional keys out of Infisical entirely;
# an empty value counts as set. The `development` environment holds the subset
# `alchemy dev` uses (the optional integrations below); local dev ignores the
# GitHub App and webhook secret.
#
# Two kinds of setting stay outside Infisical:
# - CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN come from the shell (GitHub
#   environment `production` in CI, or an Alchemy profile locally).
# - Infisical's own login: INFISICAL_IDENTITY_ID in CI (GitHub OIDC), or
#   `alchemy profile edit --add Infisical` locally.

# Neon API key Alchemy uses to create and manage the database project.
NEON_API_KEY=CHANGE_ME
# Point-in-time restore window in seconds. Defaults to 604800 (seven days);
# select a Neon plan that supports the window.
NEON_HISTORY_RETENTION_SECONDS=21600

# GitHub login method in Cloudflare Zero Trust (effectful.cloudflareaccess.com).
CLOUDFLARE_ACCESS_GITHUB_IDP_ID=CHANGE_ME

# Production GitHub App.
GITHUB_APP_ID=CHANGE_ME
# PEM private key. Multiline values are fine in Infisical.
GITHUB_APP_PRIVATE_KEY="CHANGE_ME"
# Must match the webhook secret on the GitHub App.
GITHUB_WEBHOOK_SECRET=CHANGE_ME

# Optional. The GitHub App's OAuth client for connecting GitHub accounts. Both
# are required together. Register https://<domain>/account/github/return as a
# callback URL.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# The Slack integration is disabled (SLACK_ENABLED in apps/cluster/src/Worker.ts),
# so the SLACK_* settings below are not read, and AGENT_RUNNER_MODEL_API_KEY and
# CHAT_MODEL are optional. Leave them out of Infisical until it is back on.
#
# Optional. The single Slack workspace (team ID, T...) Janitor serves. Both
# Slack features below require it.
# SLACK_WORKSPACE_ID=

# Optional. Sign in with Slack (OpenID Connect) for connecting Slack accounts.
# Requires SLACK_WORKSPACE_ID. Register https://<domain>/account/slack/return as
# a redirect URL on the app.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# Optional. Private Slack conversations. All four plus SLACK_WORKSPACE_ID and
# AGENT_RUNNER_MODEL_API_KEY must be set together.
# SLACK_APP_ID=
# SLACK_BOT_USER_ID=
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# OpenRouter API key for Slack agent sessions.
# AGENT_RUNNER_MODEL_API_KEY=
# OpenRouter model for Slack agent sessions. Defaults to z-ai/glm-5.3-flash.
# CHAT_MODEL=

# Optional. AI labeling rules evaluate to unknown until a key is set.
# OPENAI_API_KEY=
# OpenAI-compatible endpoint. Defaults to OpenAI.
# OPENAI_API_URL=
# Defaults to gpt-5.6-luna.
# LABELING_AI_MODEL=
# Input byte budget including reserved framing (4,000–64,000). Defaults to 16000.
# LABELING_AI_INPUT_BYTES=
# Cache lifetime for all AI rules, in whole seconds. Defaults to 86400.
# LABELING_AI_CACHE_TTL_SECONDS=
