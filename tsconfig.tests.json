{
  "extends": "./tsconfig.base.json",
  "references": [{ "path": "tsconfig.workspace.json" }],
  "include": [
    "alchemy.run.ts",
    "scripts/*.ts",
    "**/vitest.*.ts", // All vitest config files across all packages
    "./apps/**/*.ts",
    "./apps/**/*.json",
    "./packages/*/test/**/*.ts",
    "./packages/*/test/**/*.json"
  ],
  "exclude": ["**/node_modules/**", "**/dist/**"],
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": false,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": false,
    "types": ["node"],
    "paths": {
      // These path aliases allow us to load internal modules in tests and to use other workspace packages in tests
      // that would otherwise be considered cyclic dependencies
      "@janitor/domain": ["./packages/domain/src/index.ts"],
      "@janitor/domain/*": ["./packages/domain/src/*.ts"]
    }
  }
}
