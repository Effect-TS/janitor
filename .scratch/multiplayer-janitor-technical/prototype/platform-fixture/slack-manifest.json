{
  "display_information": {
    "name": "Janitor delivery fixture",
    "description": "Disposable private-channel integration verification"
  },
  "features": {
    "bot_user": { "display_name": "Janitor delivery fixture", "always_online": false }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "groups:history",
        "groups:read",
        "chat:write",
        "metadata.message:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://REPLACE_WITH_FIXTURE_HOST/slack/events",
      "bot_events": [
        "app_mention",
        "message.groups",
        "member_left_channel",
        "app_uninstalled",
        "tokens_revoked"
      ]
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
