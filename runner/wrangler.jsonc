{
  // Standalone packaging reference. Production is managed by ../alchemy.run.ts;
  // do not deploy this over the Alchemy-owned Worker. Not used by tests.
  "name": "janitor-agent-runner",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "durable_objects": {
    "bindings": [
      { "name": "SESSIONS", "class_name": "SessionRunner" },
      { "name": "SANDBOXES", "class_name": "Sandbox" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionRunner"] },
    { "tag": "v2", "new_sqlite_classes": ["Sandbox"] },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./bridge/Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 10,
    },
  ],
  // Set the stage-specific Janitor service and matching secret before deployment.
  "services": [{ "binding": "REPOSITORY_AUTHORITY", "service": "janitor" }],
  "r2_buckets": [
    { "binding": "WORKSPACE_CHECKPOINTS", "bucket_name": "janitor-workspace-checkpoints" },
  ],
  "observability": { "enabled": true },
}
