# Nonsecret account identity required by Alchemy's local Cloudflare emulators.
# Local resources use workerd and Docker. This token cannot authorize cloud calls.
# alchemy.run.ts loads this file after Infisical's development environment, so
# these values win over anything stored there. Keep real secrets in Infisical.
CI=1
CLOUDFLARE_ACCOUNT_ID=00000000000000000000000000000000
CLOUDFLARE_API_TOKEN=local-emulation-only
